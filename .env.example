# dots.ocr frontend deployment — environment variables.
#
# Copy this file to `.env` and adjust as needed:
#   cp .env.example .env
#
# `.env` is git-ignored and never committed. Only `.env.example` is tracked.

# ---------------------------------------------------------------------------
# vLLM inference backend (the app service calls it via OpenAI API).
# Point this at your vLLM server, e.g. a host IP or a service name on the same
# Docker network.
# ---------------------------------------------------------------------------
DOTS_OCR_IP=127.0.0.1
DOTS_OCR_PORT=8000

# ---------------------------------------------------------------------------
# Gradio frontend service (app container)
# ---------------------------------------------------------------------------
# Host/interface the Gradio server binds inside the container.
GRADIO_HOST=0.0.0.0
# Port the Gradio server listens on. Must match the Traefik loadbalancer port
# below so Traefik forwards to the right container port.
GRADIO_PORT=7860
# Reverse-proxy path prefix. Keep it aligned with the Traefik router rule
# `PathPrefix(\`/ocr\`)` in docker-compose.yml.
GRADIO_ROOT_PATH=/ocr

# ---------------------------------------------------------------------------
# Flask interceptor service
# ---------------------------------------------------------------------------
# Port the interceptor listens on. Must match the Traefik loadbalancer port
# for the interceptor router in docker-compose.yml.
INTERCEPTOR_PORT=8000
